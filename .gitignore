# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Virtualenvs ---
.venv/
venv/
env/
.python-version

# --- Build / distribution ---
# PyInstaller intermediate output (specs in build/ are kept)
build/_work/
build/*.toc
build/*.pkg
build/warn-*.txt
dist/
*.spec.bak

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Project-specific ---
# Local sprite-sheet sources users hand to Nano Banana (heavy, regenerable)
source.png
source_anim_*.png
source_anim_*.jpg

# Chiikawa-derived assets — third-party IP, kept LOCAL only.
# Anyone wanting the chibi pack must extract their own from a source they
# legally hold and place it under these paths.
src/claukawa/assets/scenes/chibi/
src/claukawa/assets/gifs/default/*.png

# Hook payload dump (created only when debug logging is on; never tracked)
claukawa-hook-dump.jsonl

# Backups generated by hook_installer
**/settings.json.claukawa-backup-*
