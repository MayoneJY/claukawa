# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Virtualenvs ---
.venv/
venv/
env/
.python-version

# --- Build / distribution ---
# PyInstaller intermediate output (specs in build/ are kept)
build/_work/
build/*.toc
build/*.pkg
build/warn-*.txt
build/claukawa-*/
dist/
*.spec.bak

# --- IDE / editor ---
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Project-specific ---
# Local sprite-sheet sources (heavy, regenerable from the tools/ scripts)
source.png
source_default.png
source_anim_*.png
source_anim_*.jpg

# Chiikawa-derived assets — third-party IP, kept LOCAL only.
# Anyone wanting the chibi pack must extract their own from a source they
# legally hold and place it under this path.
src/claukawa/assets/scenes/chibi/

# Hook payload dump (created only when debug logging is on; never tracked)
claukawa-hook-dump.jsonl

# Backups generated by hook_installer
**/settings.json.claukawa-backup-*
